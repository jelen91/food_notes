# Zkopíruj do .env (nebo .env.local) a doplň hodnoty. Skutečné .env do gitu nepatří.

# --- databáze ---
MONGODB_URI=mongodb+srv://uzivatel:heslo@cluster.mongodb.net/food_notes
# MONGODB_DB=food_notes            # volitelné, výchozí je food_notes

# --- bezpečnost ---
# Podpis přihlašovacích cookies. Dlouhý náhodný řetězec: openssl rand -base64 48
AUTH_SECRET=
# Šifrování datových klíčů zákazníků. Přesně 32 bajtů: openssl rand -base64 32
# POZOR: bez tohoto klíče nejdou data přečíst. Zálohuj ho mimo repozitář i mimo hosting.
MASTER_KEY=

# --- aplikace ---
APP_URL=http://localhost:3000
# DEFAULT_TENANT_SLUG=             # volitelné: kořen / přesměruje na tento deník

# --- platby (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# --- e-maily (Resend) ---
# Bez těchto proměnných se e-maily neposílají a odkazy se vypisují do serverové konzole.
RESEND_API_KEY=
EMAIL_FROM="Deník <no-reply@tvojedomena.cz>"

# --- generování trackeru (Claude) ---
# Klíč zůstává jen na serveru. Bez něj se tracker nevygeneruje a uživatel dostane
# neutrální hlášku "Sestavení teď není dostupné".
ANTHROPIC_API_KEY=
# Volitelné; výchozí je claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
